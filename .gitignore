node_modules/
.DS_Store
*.log
tsconfig.tsbuildinfo

# Ancien dossier de build : le site est maintenant construit à la racine
# (index.html et assets/ sont versionnés, c'est la racine qui est publiée).
dist/

# PDF de règles : propriété des éditeurs. Les PDF listés ci-dessous ont été
# ajoutés volontairement par le propriétaire du dépôt ; les autres restent
# locaux. `npm run crops` en a besoin pour rendre les découpes.
rules/*.pdf
!rules/Nemesis\ -\ Regles.pdf
!rules/Tainted\ Grail\ -\ Regles.pdf
!rules/Expeditions\ -\ Regles\ FR.pdf
!rules/Expeditions\ -\ Accomplissements.pdf
!rules/Frosthaven_Rules_-_Part_1.pdf
!rules/Frosthaven_Rules_-_Part_2.pdf
!rules/Frosthaven_Rules_-_Part_3.pdf
!rules/Bitoku_Rulebook_FR_V1_Light.pdf
!rules/Nemesis\ -\ Rules\ VO.pdf
!rules/Tainted\ Grail\ Rois\ de\ la\ Ruine\ -\ Regles.pdf
# « Frosthaven - Regles.pdf » est la fusion des trois parties (npm run merge) :
# il se refait en une commande et reste local.
rules/*.txt

# Aperçus et bundle temporaire produits par `npm run extract` / `npm run crops`.
.extract/
