{
  "name": "tutogames",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Tutoriels interactifs de jeux de societe pour iPad, generes a partir des regles PDF.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "ingest": "node tools/ingest.mjs",
    "extract": "node tools/extract-images.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.83",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "pdfjs-dist": "^4.10.38",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
